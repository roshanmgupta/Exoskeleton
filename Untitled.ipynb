    "import asyncio\n",
    "from bleak import BleakScanner\n",
    "\n",
    "async def scan():\n",
    "    devices = await BleakScanner.discover()\n",
    "    for d in devices:\n",
    "        print(d.address, d.name)\n",
    "\n",
    "asyncio.run(scan())\n"
