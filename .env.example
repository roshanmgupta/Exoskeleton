# Copy to .env (or export in your shell) to override defaults in config_live.py

# Kafka broker endpoints (comma-separated)
KAFKA_BROKERS=localhost:9092
FATIGUE_ALERT_TOPIC=exolink_emg_mdf_fatigue_alerts
FEATURES_VISUALIZATION_TOPIC=exolink_emg_shirt01_libemg_features

# Raw EMG streaming ("kafka" or "mqtt")
ENABLE_RAW_STREAMER=true
RAW_BROKER_TYPE=kafka
MQTT_HOST=localhost
MQTT_PORT=1883

# Participant identifier included in feature payloads
PARTICIPANT_ID=demo-participant-01

# Local UDP bind host between BLE/mock streamers and main processor
UDP_STREAM_HOST=127.0.0.1

# Physical MCell BLE MAC addresses (only needed for live hardware mode)
BLE_ADDR_LEFT=00:00:00:00:00:01
BLE_ADDR_RIGHT=00:00:00:00:00:02
BLE_ADDR_TRUNK=00:00:00:00:00:03

# Live Matplotlib visualization ("true" or "false")
ENABLE_LIVE_VISUALIZATION=false
VISUALIZATION_DEVICE_NAME_TARGET=Shirt01-Right
LOG_LEVEL=INFO
